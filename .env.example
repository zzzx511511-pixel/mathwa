# Next.js
NEXT_PUBLIC_APP_NAME="مثوى العقارية"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# Server-side only (do not expose)
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Demo mode (preview without Supabase)
# Set true to render portals with mock data (no real auth).
# عند التعطيل: صفحة /employee/access تعرض دخول الموظف بالبريد + القسم (حساب لكل موظف في Supabase Auth).
NEXT_PUBLIC_DEMO_MODE="false"
# نفس أثر DEMO_MODE — مريح للمعاينة حتى التفعيل (يمكنك الاكتفاء به أو بـ DEMO_MODE)
NEXT_PUBLIC_PREVIEW_UNTIL_LIVE="false"
# Optional: which role to simulate in demo (جدول users وهمي). للمعاينة كمدير تنفيذي بصلاحية كل الأقسام: super_admin أو manager
DEMO_ROLE="employee"

# تفعيل الموقع للإنتاج (أوّل نشر):
#   NEXT_PUBLIC_DEMO_MODE="false"
#   NEXT_PUBLIC_PREVIEW_UNTIL_LIVE="false"
#   NEXT_PUBLIC_EMPLOYEE_PORTAL_OPEN="false"
#   NEXT_PUBLIC_AUTH_UI_DISABLED="false"
# ثم عيّن NEXT_PUBLIC_SUPABASE_* و SUPABASE_SERVICE_ROLE_KEY، ويفضّل DEPARTMENT_SESSION_SECRET (قيمة عشوائية طويلة).
#
# فتح بوابة الموظفين بدون تحقق أقسام (تطوير فقط):
# NEXT_PUBLIC_EMPLOYEE_PORTAL_OPEN="true"

# ——— دخول برمز 6 أرقام (مواصفة مثوى 2025) ———
# يلزم تنفيذ docs/supabase-auth-spec-access-code.sql ورَبط كلمة مرور Auth بالرمز.
# POST /api/auth/login  { "code": "123456" }

# تقييد قسم الموظف بعد الدخول بالبريد: في لوحة Supabase → Authentication → Users → User Metadata أضف مثلاً:
#   "allowed_departments": ["estates","finance"]
# إن لم تُضف المفتاح، يُسمح بأي قسم من القائمة.
#
# بوابة القسم (بريد + كلمة مرور للقسم قبل الرمز الشخصي) — انظر docs/supabase-department-portal.sql
# لتعطيل الخطوة الأولى والاكتفاء بالرمز فقط (قديم):
# EMPLOYEE_GATEWAY_DISABLED="true"
# سر توقيع كوكي بوابة القسم (اختياري):
# EMPLOYEE_DEPT_GATE_SECRET=""

# غرف أقسام الموظفين: رقم تعريف لكل قسم عبر Supabase (انظر docs/supabase-employee-department-access.sql)
# إجبار تعطيل التحقق مؤقتًا (للتطوير فقط):
# EMPLOYEE_DEPT_ACCESS_DISABLED="true"
# سر توقيع كوكي جلسة القسم (يفضّل قيمة عشوائية طويلة في الإنتاج):
# DEPARTMENT_SESSION_SECRET=""

